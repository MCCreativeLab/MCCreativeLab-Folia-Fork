From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: verdox <mail.ysp@web.de>
Date: Sun, 2 Feb 2025 19:25:09 +0000
Subject: [PATCH] Add BlockBehavior


diff --git a/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java b/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
index 69c0e315c77c0e4b8df048961c39f96958e21f89..1eb0c93d74774d4c033c1e7b6fd8e28b526672e0 100644
--- a/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
+++ b/src/main/java/org/bukkit/craftbukkit/block/CraftBlock.java
@@ -767,7 +767,7 @@ public class CraftBlock implements Block {
         }
         // Folia end - region threading
         final ServerLevel level = this.level.getMinecraftWorld();
-        this.getBlockState().tick(level, this.position, level.getRandom());
+        this.getBlockState().mcc$tick(level, this.position, level.getRandom());
     }
 
     @Override
@@ -788,6 +788,6 @@ public class CraftBlock implements Block {
         }
         // Folia end - region threading
         final ServerLevel level = this.level.getMinecraftWorld();
-        this.getBlockState().randomTick(level, this.position, level.getRandom());
+        this.getBlockState().mcc$randomTick(level, this.position, level.getRandom());
     }
 }
